# Copy this file to .env and fill in real values before deploying.
# The app runs fine without a .env for local/demo use (safe random
# defaults are generated), but you MUST set these for production.

# Long random string used to sign JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=875023a3843ae356e339b4df989e6a24b4d313b79bd1f083eb526141d80d3b82

# Minutes before an access token expires
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Database. Default = MySQL / MariaDB (XAMPP) - everything you do in the app is
# stored there and shows up in phpMyAdmin. The database is created automatically.
# XAMPP default login is user "root" with an EMPTY password. Port is 3306 unless
# the XAMPP Control Panel shows something else (e.g. 3307).
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/spendsense-xai?charset=utf8mb4
# With a password:   mysql+pymysql://root:yourpassword@127.0.0.1:3306/spendsense-xai
# File database (no server needed):   sqlite:///./spendsense.db
# If DATABASE_URL is set and unreachable the app stops with a clear error - it never
# silently stores data somewhere else.

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
